# Copy to .env (never commit .env). Personal Cloudflare R2 S3 API token.
# Create at: Cloudflare dashboard -> R2 -> Manage R2 API Tokens
# Permission: Object Read & Write on ac-media-personal + ac-media-client
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Bucket names and public base URLs are NOT secret -- they live in buckets.json.

# Optional: override the S3 endpoint (local testing / S3-compatible hosts)
# R2_ENDPOINT=
